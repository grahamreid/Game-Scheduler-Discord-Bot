# Local MongoDB, either native Community Server or Docker Compose.
MONGODB_URI=mongodb://127.0.0.1:27017/board-game-scheduler

# Discord test-server bot configuration.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_TEST_GUILD_ID=

# Opt-in local availability closer. Leave false for normal manual testing.
ENABLE_LOCAL_ROUND_CLOSER=false
ROUND_CLOSER_INTERVAL_MS=30000
